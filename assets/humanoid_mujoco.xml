<mujoco model="humanoid">
  <!-- AI Playground player model. Corrected Nov 2026: every joint is named (actuators reference bare
       joint names), the head is three hinges (pitch/yaw/roll) instead of one ball joint driven by three
       motors, the figure stands along +Z and FACES +Y: sagittal (walk-direction) limb hinges are X-hinges, feet are long along Y (walk direction); re-axised Nov 17,
       there is a ground plane, and there are no absolute asset paths. Verified with mujoco 4.0.1. -->
  <compiler angle="degree"/>

  <asset>
    <texture type="skybox" builtin="gradient" width="512" height="3072" rgb1=".4 .6 .8" rgb2=".9 .9 .9"/>
    <material name="GroundMat" reflectance="0.4" rgba="0.2 0.2 0.2 1"/>
    <material name="SkinMat" rgba="0.7 0.65 0.6 1"/>
    <material name="ClothingMat" rgba="0.3 0.25 0.2 1"/>
  </asset>

  <default>
    <joint damping="1.5" limited="true" range="-90 90"/>
  </default>

  <worldbody>
    <geom name="ground" type="plane" size="3 3 0.05" material="GroundMat"/>
    <!-- Root spine is welded to the world (asset rig check); the figure stands 1.6 m tall to match the
         island agent body (0.44 m wide, 1.6 m tall collision box). -->
    <body name="torso" pos="0 0 1.15">
      <inertial mass="7.0" pos="0 0 0" diaginertia="0.8 0.6 0.4"/>
      <geom name="g:torso" type="box" size="0.14 0.09 0.25" material="ClothingMat"/>

      <!-- Spine hinge for upper-body lean -->
      <body name="spine_L2" pos="0 0 0.25">
        <joint name="spine_L2" type="hinge" axis="1 0 0"/>
        <geom name="g:chest" type="box" size="0.13 0.085 0.08" material="ClothingMat" pos="0 0 0"/>

        <!-- Left arm: shoulder -> elbow -> hand, hanging straight down (-Z) -->
        <body name="left_shoulder" pos="0.185 0 -0.02">
          <joint name="left_shoulder" type="hinge" axis="1 0 0"/>
          <geom name="g:left_upper_arm" type="capsule" size="0.04" fromto="0 0 0 0 0 -0.28" material="ClothingMat"/>
          <body name="left_elbow" pos="0 0 -0.28">
            <joint name="left_elbow" type="hinge" axis="1 0 0"/>
            <geom name="g:left_forearm" type="capsule" size="0.032" fromto="0 0 0 0 0 -0.26" material="SkinMat"/>
          </body>
        </body>

        <!-- Right arm -->
        <body name="right_shoulder" pos="-0.185 0 -0.02">
          <joint name="right_shoulder" type="hinge" axis="1 0 0"/>
          <geom name="g:right_upper_arm" type="capsule" size="0.04" fromto="0 0 0 0 0 -0.28" material="ClothingMat"/>
          <body name="right_elbow" pos="0 0 -0.28">
            <joint name="right_elbow" type="hinge" axis="1 0 0"/>
            <geom name="g:right_forearm" type="capsule" size="0.032" fromto="0 0 0 0 0 -0.26" material="SkinMat"/>
          </body>
        </body>

        <!-- Head: pitch / yaw / roll hinges composed on one body -->
        <body name="head" pos="0 0 0.08">
          <joint name="head_pitch" type="hinge" axis="1 0 0"/>
          <joint name="head_yaw" type="hinge" axis="0 0 1"/>
          <joint name="head_roll" type="hinge" axis="0 1 0"/>
          <geom name="g:head" type="sphere" size="0.115" material="SkinMat" pos="0 0 0.26"/>
        </body>
      </body>

      <!-- Left leg: hip -> knee -> ankle + foot -->
      <body name="left_hip" pos="0.09 0 -0.27">
        <joint name="left_hip" type="hinge" axis="1 0 0"/>
        <geom name="g:left_thigh" type="capsule" size="0.055" fromto="0 0 0 0 0 -0.38" material="ClothingMat"/>
        <body name="left_knee" pos="0 0 -0.38">
          <joint name="left_knee" type="hinge" axis="1 0 0"/>
          <geom name="g:left_shin" type="capsule" size="0.04" fromto="0 0 0 0 0 -0.44" material="ClothingMat"/>
          <body name="left_ankle" pos="0 0 -0.44">
            <inertial pos="0 0 -0.02" mass="0.18" diaginertia="0.0002 0.0002 0.0002"/>
            <joint name="left_ankle" type="hinge" axis="1 0 0"/>
            <body name="left_foot">
              <joint name="left_foot_yaw" type="hinge" axis="0 0 1" limited="true" range="-3.1416 3.1416" damping="2.0"/>
              <geom name="g:left_foot" type="box" size="0.045 0.09 0.03" material="ClothingMat" pos="0 0.02 -0.03"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Right leg -->
      <body name="right_hip" pos="-0.09 0 -0.27">
        <joint name="right_hip" type="hinge" axis="1 0 0"/>
        <geom name="g:right_thigh" type="capsule" size="0.055" fromto="0 0 0 0 0 -0.38" material="ClothingMat"/>
        <body name="right_knee" pos="0 0 -0.38">
          <joint name="right_knee" type="hinge" axis="1 0 0"/>
          <geom name="g:right_shin" type="capsule" size="0.04" fromto="0 0 0 0 0 -0.44" material="ClothingMat"/>
          <body name="right_ankle" pos="0 0 -0.44">
            <inertial pos="0 0 -0.02" mass="0.18" diaginertia="0.0002 0.0002 0.0002"/>
            <joint name="right_ankle" type="hinge" axis="1 0 0"/>
            <body name="right_foot">
              <joint name="right_foot_yaw" type="hinge" axis="0 0 1" limited="true" range="-3.1416 3.1416" damping="2.0"/>
              <geom name="g:right_foot" type="box" size="0.045 0.09 0.03" material="ClothingMat" pos="0 0.02 -0.03"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="spine" joint="spine_L2" ctrlrange="-30 30"/>
    <motor name="left_shoulder" joint="left_shoulder" ctrlrange="-15 15"/>
    <motor name="left_elbow" joint="left_elbow" ctrlrange="-8 8"/>
    <motor name="right_shoulder" joint="right_shoulder" ctrlrange="-15 15"/>
    <motor name="right_elbow" joint="right_elbow" ctrlrange="-8 8"/>
    <motor name="left_hip" joint="left_hip" ctrlrange="-30 30"/>
    <motor name="left_knee" joint="left_knee" ctrlrange="-24 24"/>
    <motor name="right_hip" joint="right_hip" ctrlrange="-30 30"/>
    <motor name="right_knee" joint="right_knee" ctrlrange="-24 24"/>
    <motor name="head_pitch" joint="head_pitch" ctrlrange="-3 3"/>
    <motor name="head_yaw" joint="head_yaw" ctrlrange="-3 3"/>
    <motor name="head_roll" joint="head_roll" ctrlrange="-3 3"/>
  </actuator>

</mujoco>
